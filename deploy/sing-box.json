{
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "yandex",
        "server": "77.88.8.8"
      },
      {
        "server": "8.8.8.8",
        "tag": "google",
        "tls": {
          "server_name": "dns.google"
        },
        "type": "https"
      },
      {
        "type": "https",
        "tag": "cloudflare",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "server_name": "cloudflare-dns.com"
        },
        "domain_resolver": "yandex"
      }
    ],
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "access_control_allow_origin": [
        "*"
      ],
      "access_control_allow_private_network": true
    }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "endpoint_independent_nat": false,
      "interface_name": "tun0",
      "auto_redirect": true,
      "stack": "system",
      "mtu": 1420,
      "route_exclude_address_set": [
        "configurer-bypass"
      ]
    },
    {
      "type": "mixed",
      "tag": "mixed-proxy",
      "listen": "0.0.0.0",
      "listen_port": 1080,
      "users": []
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "0.0.0.0",
      "listen_port": 53
    }
  ],
  "endpoints": [],
  "outbounds": [
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        "direct"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "select-default",
      "outbounds": [
        "direct"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "cloudflare"
    },
    "final": "select-default",
    "rules": [
      {
        "action": "bypass",
        "rule_set": "configurer-bypass"
      },
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "resolve",
        "strategy": "ipv4_only"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "configurer",
        "outbound": "select"
      }
    ],
    "rule_set": [
      {
        "tag": "configurer",
        "type": "remote",
        "format": "source",
        "url": "http://127.0.0.1:8080/api/ruleset",
        "update_interval": "30s",
        "http_client": {
          "tag": "default_http_client"
        }
      },
      {
        "tag": "configurer-bypass",
        "type": "remote",
        "format": "source",
        "url": "http://127.0.0.1:8080/api/ruleset/bypass",
        "update_interval": "30s",
        "http_client": {
          "tag": "default_http_client"
        }
      }
    ]
  },
  "http_clients": [
    {
      "tag": "default_http_client"
    }
  ],
  "log": {
    "level": "warn",
    "timestamp": true
  }
}